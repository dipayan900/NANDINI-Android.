rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isConversationMember(conversationId) {
      return signedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/connect_conversations/$(conversationId)
        ).data.members;
    }

    match /connect_media/{conversationId}/{uid}/{fileName} {
      allow read: if isConversationMember(conversationId);
      allow write: if isConversationMember(conversationId)
        && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/.*|video/.*|audio/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*'
        );
    }
  }
}