<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NandiniTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF84BE</item>
        <item name="android:colorControlActivated">#FF84BE</item>
        <item name="android:colorControlHighlight">#55FF84BE</item>
        <item name="android:colorControlNormal">#C6A9C9</item>
        <item name="android:textColorPrimary">#FFF7FC</item>
        <item name="android:textColorSecondary">#C6A9C9</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0D0716</item>
        <item name="android:navigationBarColor">#0D0716</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@drawable/nandini_dialog_bg</item>
    </style>

    <style name="ArushiLightTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#704BAE</item>
        <item name="android:colorControlActivated">#704BAE</item>
        <item name="android:colorControlHighlight">#55704BAE</item>
        <item name="android:statusBarColor">#F7F5FC</item>
        <item name="android:navigationBarColor">#F7F5FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F5FC</item>
    </style>
    <style name="ArushiDarkTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C397FF</item>
        <item name="android:colorControlActivated">#C397FF</item>
        <item name="android:colorControlHighlight">#55C397FF</item>
        <item name="android:statusBarColor">#0A0916</item>
        <item name="android:navigationBarColor">#0A0916</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0A0916</item>
    </style>

</resources>