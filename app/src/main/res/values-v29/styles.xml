<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 10+ follows the device's System light/dark appearance automatically. -->
    <style name="NandiniTheme" parent="@android:style/Theme.Material.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B78AEF</item>
        <item name="android:colorControlActivated">#B78AEF</item>
        <item name="android:colorControlHighlight">#55B78AEF</item>
        <item name="android:colorControlNormal">#B9AED3</item>
        <item name="android:textColorPrimary">?android:attr/textColorPrimary</item>
        <item name="android:textColorSecondary">?android:attr/textColorSecondary</item>
        <item name="android:windowLightStatusBar">?android:attr/windowLightStatusBar</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:forceDarkAllowed">true</item>
    </style>
</resources>
