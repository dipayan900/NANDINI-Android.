rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(conversationId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/connect_conversations/$(conversationId)).data.members;
    }

    match /connect_usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /connect_profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /connect_conversations/{conversationId} {
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 256;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if signedIn()
        && request.auth.uid in resource.data.members
        && (resource.data.admins == null || request.auth.uid in resource.data.admins);

      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.conversationId == conversationId;
        allow update: if isMember(conversationId)
          && (resource.data.senderId == request.auth.uid
              || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'deletedFor']));
        allow delete: if isMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    match /connect_status/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}